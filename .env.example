# CleanTranslate configuration (copy to .env for Docker Compose, or to
# /etc/cleantranslate.env for the native systemd install). Everything is optional.

# Port the app listens on (inside Docker it is always 8080; CT_PORT is the host port).
PORT=8080
CT_PORT=8080
# Bind the published Docker port to localhost only when a reverse proxy runs on the same host:
# CT_BIND=127.0.0.1

# Serve under a sub-path, e.g. https://example.com/translate/  (leave empty for / or a subdomain)
BASE_PATH=

# Where the SQLite database lives (native install; Docker uses the /data volume)
# DATA_DIR=/var/lib/cleantranslate

# Optional passwords ("user:password"). No login is required when empty.
#   ADMIN_AUTH protects /admin and the admin API only; BASIC_AUTH protects everything.
ADMIN_AUTH=
BASIC_AUTH=

# Set to false to remove the admin dashboard completely.
ADMIN_ENABLED=true

# Sites allowed to show the editor in an <iframe> (overrides the admin setting), e.g.
#   FRAME_ANCESTORS='self' https://dashboard.example.com
FRAME_ANCESTORS=

# Trust X-Forwarded-For from your reverse proxy (for per-IP API rate limits).
TRUST_PROXY=true

# If the server must reach the internet through an HTTP proxy (Node >= 22.21 / 24):
# HTTPS_PROXY=http://proxy.internal:3128
# NODE_USE_ENV_PROXY=1

# Languages loaded by the optional LibreTranslate container
LT_LOAD_ONLY=en,es,fr,de,it,pt
